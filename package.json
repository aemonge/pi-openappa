{
  "name": "pi-openappa",
  "version": "0.3.2",
  "description": "Thin OpenAPPA guard extension for Pi: gates tool calls through the APPA runtime. No policy logic lives here.",
  "keywords": [
    "pi-package",
    "openappa",
    "appa",
    "security",
    "guardrails",
    "policy"
  ],
  "license": "MIT",
  "author": "aemonge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aemonge/pi-openappa.git"
  },
  "homepage": "https://github.com/aemonge/pi-openappa#readme",
  "bugs": "https://github.com/aemonge/pi-openappa/issues",
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "files": [
    "extensions/",
    "src/",
    "templates/",
    "traces/",
    "docs/",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "main": "./extensions/index.ts",
  "scripts": {
    "test": "node --test 'test/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "typescript": "^7.0.2"
  }
}
