# Day D — secret ops. Reading .env narrows the audience to self: plain web
# research is then refused (the query cannot be proven shareable), but the
# trusted-docs curl carve-outs keep working, and the narrowed bash result
# still returns masked (confined + redact-secrets).
host/claude-code/Read {
  path: ".env"
}
expect allow

host/claude-code/web_explore {
  query: "how to rotate STRIPE_KEY"
}
expect deny

host/claude-code/Bash {
  command: "cat .env"
}
expect allow

host/claude-code/Bash {
  command: "curl -s https://docs.anthropic.com/en/docs/claude-code/settings"
}
expect allow
